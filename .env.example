# Skopiuj ten plik jako .env i uzupełnij wartości
# cp .env.example .env

# ── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_DB=uni_calendar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=zmien_na_silne_haslo

# ── JWT (Spring Boot) ────────────────────────────────────────────────
JWT_SECRET=zmien-na-dlugi-losowy-ciag-znakow-minimum-64-znaki-base64
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# ── Superuser (tworzony automatycznie przy pierwszym starcie) ─────────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=zmien_na_silne_haslo

# ── CORS ──────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# ── Redis ─────────────────────────────────────────────────────────────
# W Docker Compose ustawiany automatycznie jako redis://redis:6379/0
# Zmień tylko jeśli używasz zewnętrznego Redis
# REDIS_URL=redis://redis:6379/0

# ── Reset Hasła ───────────────────────────────────────────────────────
# URL frontendu używany do generowania linków resetujących hasło
FRONTEND_URL=http://localhost

# ── Email (opcjonalnie – bez ustawienia EMAIL_HOST maile trafiają do konsoli) ──
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=twoj@gmail.com
# EMAIL_HOST_PASSWORD=haslo_aplikacji
# DEFAULT_FROM_EMAIL=noreply@uni-calendar.pl
