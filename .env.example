# Skopiuj ten plik jako .env i uzupelnij wartosci
# cp .env.example .env

# -- Domena niestandardowa (Custom Domain) ----------------------------
DOMAIN_NAME=unicalendar.pl
FRONTEND_URL=https://unicalendar.pl
CORS_ALLOWED_ORIGINS=https://unicalendar.pl,https://www.unicalendar.pl,http://localhost,http://127.0.0.1

# -- PostgreSQL -------------------------------------------------------
POSTGRES_DB=uni_calendar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=zmien_na_silne_haslo

# -- JWT (Spring Boot) ------------------------------------------------
JWT_SECRET=zmien-na-dlugi-losowy-ciag-znakow-minimum-64-znaki-base64
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# -- Redis ------------------------------------------------------------
# W Docker Compose ustawiany automatycznie jako redis://redis:6379/0
# REDIS_URL=redis://redis:6379/0

# -- Email (opcjonalnie - bez ustawienia EMAIL_HOST maile trafiaja do konsoli) --
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=twoj@gmail.com
# EMAIL_HOST_PASSWORD=haslo_aplikacji
# DEFAULT_FROM_EMAIL=noreply@unicalendar.pl
